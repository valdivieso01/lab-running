rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {userId} (matches Firebase Auth request.auth.uid)
// Fields:
//   - uid: string (optional, immutable, must match userId if present) - Owner Firebase Auth UID
//   - email: string (optional, max 254 chars) - User email address (PII, owner-only access)
//   - displayName: string (optional, max 120 chars) - User display name
//   - photoURL: string (optional, max 500 chars) - User avatar URL
//   - timeSeconds: number (optional, 300..10800) - 5K reference time in seconds
//   - terrain: string (optional, max 30 chars) - Selected running terrain ('calle', 'pista', 'tierra', 'trail')
//   - inputMethod: string (optional, max 30 chars) - Active input mode ('manual' | 'strava')
//   - useStravaCalibration: bool (optional) - Whether physiological Strava calibration is active
//   - stravaSummary: map (optional) - Parsed Strava/Garmin analysis summary & HR/strength profiles
//   - hrProfile: map (optional) - Heart rate zones and recorded max HR
//   - calibration: map (optional) - Personal Riegel exponent and aerobic calibration data
//   - strengthSynergy: map (optional) - Strength & cross-training synergy metrics
//   - createdAt: timestamp or string or number (optional, immutable on update) - Profile creation time
//   - updatedAt: timestamp or string or number (optional) - Profile last sync timestamp
//
// Subcollection: users/{userId}/snapshots
// Document ID: {snapshotId}
// Fields:
//   - uid: string (optional, immutable, must match userId if present) - Owner Firebase Auth UID
//   - vdot: number (optional, 10..95) - Calculated Jack Daniels VDOT score
//   - timeSeconds: number (optional, 300..10800) - 5K equivalent time in seconds
//   - terrain: string (optional, max 30 chars) - Terrain context for snapshot
//   - inputMethod: string (optional, max 30 chars) - Source ('manual' | 'strava')
//   - label: string (optional, max 200 chars) - Snapshot label or note
//   - stravaSummary: map (optional) - Historical Strava/Garmin metrics at snapshot time
//   - createdAt: timestamp or string or number (optional, immutable on update) - Snapshot creation time
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource by path parameter
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID matches the path userId and authenticated user if present
    function uidMatchesPath(userId) {
      return !('uid' in request.resource.data) ||
        (request.resource.data.uid is string &&
         request.resource.data.uid == userId &&
         request.resource.data.uid == request.auth.uid);
    }

    // Ensure uid field is not modified on update if already stored
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Ensure createdAt field is not modified on update if already stored
    function createdAtNotModified() {
      return !('createdAt' in request.resource.data) ||
        !('createdAt' in resource.data) ||
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Validate optional string field length
    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate optional numeric range
    function isValidOptionalNumber(field, minVal, maxVal) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= minVal &&
         request.resource.data[field] <= maxVal);
    }

    // Validate optional boolean field
    function isValidOptionalBool(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is bool;
    }

    // Validate optional map field with bounded keys
    function isValidOptionalMap(field, maxKeys) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is map &&
         request.resource.data[field].keys().size() <= maxKeys);
    }

    // ===============================================================
    // Domain Validators (Applied on both create and update)
    // ===============================================================

    function isValidUserProfile(userId) {
      return request.resource.data.keys().size() <= 40 &&
        uidMatchesPath(userId) &&
        isValidOptionalString('email', 254) &&
        isValidOptionalString('displayName', 120) &&
        isValidOptionalString('photoURL', 500) &&
        isValidOptionalString('terrain', 30) &&
        isValidOptionalString('terrainType', 30) &&
        isValidOptionalString('inputMethod', 30) &&
        isValidOptionalNumber('timeSeconds', 300, 10800) &&
        isValidOptionalNumber('fiveKmSeconds', 300, 10800) &&
        isValidOptionalNumber('vdot', 10, 95) &&
        isValidOptionalBool('useStravaCalibration') &&
        isValidOptionalMap('stravaSummary', 50) &&
        isValidOptionalMap('hrProfile', 20) &&
        isValidOptionalMap('calibration', 30) &&
        isValidOptionalMap('strengthSynergy', 40);
    }

    function isValidSnapshot(userId) {
      return request.resource.data.keys().size() <= 35 &&
        uidMatchesPath(userId) &&
        isValidOptionalString('label', 200) &&
        isValidOptionalString('notes', 500) &&
        isValidOptionalString('terrain', 30) &&
        isValidOptionalString('inputMethod', 30) &&
        isValidOptionalString('date', 50) &&
        isValidOptionalNumber('timeSeconds', 300, 10800) &&
        isValidOptionalNumber('vdot', 10, 95) &&
        isValidOptionalNumber('weeklyKmAvg', 0, 500) &&
        isValidOptionalNumber('longestRunKm', 0, 300) &&
        isValidOptionalMap('stravaSummary', 50);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Only the authenticated owner can read their own profile
      allow read: if isOwner(userId);

      // Only the authenticated owner can create their own profile with valid data
      allow create: if isOwner(userId) &&
        isValidUserProfile(userId);

      // Only the authenticated owner can update their own profile; immutable fields protected
      allow update: if isOwner(userId) &&
        isValidUserProfile(userId) &&
        uidNotModified() &&
        createdAtNotModified();

      // Only the authenticated owner can delete their own profile
      allow delete: if isOwner(userId);

      // Historical VDOT & fitness progress snapshots subcollection
      match /snapshots/{snapshotId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidSnapshot(userId);

        allow update: if isOwner(userId) &&
          isValidSnapshot(userId) &&
          uidNotModified() &&
          createdAtNotModified();

        allow delete: if isOwner(userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
